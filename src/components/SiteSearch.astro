---
// Keyboard-accessible site search, adapted to the compact academic portfolio.
// No network requests, frameworks, tracking, or new dependencies.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<button
  type="button"
  class="site-search-launch"
  data-site-search-trigger
  data-base={base}
  aria-label="Search pages (Ctrl+K)"
  title="Search pages (Ctrl+K)"
  aria-haspopup="dialog"
>
  <span class="site-search-icon" aria-hidden="true">⌕</span>
  <kbd aria-hidden="true">Ctrl K</kbd>
</button>

<dialog class="site-search-dialog" data-site-search-dialog aria-label="Search this website">
  <div class="site-search-head">
    <span class="site-search-icon" aria-hidden="true">⌕</span>
    <input class="site-search-input" type="search" autocomplete="off" spellcheck="false"
           aria-label="Search research and projects"
           placeholder="Search research and projects…" />
    <button class="site-search-close" type="button" aria-label="Close search">Esc</button>
  </div>
  <nav class="site-search-results" aria-label="Search results"></nav>
  <div class="site-search-footer">↑ ↓ Navigate <span>·</span> Enter Open <span>·</span> Esc Close</div>
</dialog>

<style>
  .site-search-launch {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    height: 39px; min-width: 92px; padding: 0 12px;
    border: 1px solid var(--line); border-radius: 22px;
    background: var(--paper); color: var(--ink); flex-shrink: 0;
    font: 500 11px/1 'IBM Plex Mono', ui-monospace, monospace;
    transition: border-color .15s ease;
  }
  .site-search-launch:hover { border-color: var(--accent); }
  .site-search-icon { font: 400 23px/1 'Source Sans 3', sans-serif; }
  .site-search-launch kbd { font: inherit; color: var(--muted); white-space: nowrap; }
  .site-search-dialog {
    position: fixed; inset: clamp(32px, 12vh, 140px) 0 auto;
    margin: 0 auto; padding: 0;
    width: min(620px, calc(100vw - 32px)); max-width: none;
    max-height: min(72vh, 560px);
    border: 1px solid var(--line); border-radius: 16px;
    background: var(--paper); color: var(--ink);
    box-shadow: 0 24px 70px rgba(7, 13, 24, .22);
    overflow: hidden;
  }
  .site-search-dialog::backdrop { background: rgba(7, 13, 24, .56); }
  .site-search-head {
    display: flex; align-items: center; gap: 13px;
    padding: 18px 19px; border-bottom: 1px solid var(--line);
  }
  .site-search-head > .site-search-icon { color: var(--accent); }
  .site-search-input {
    flex: 1; min-width: 0; width: 100%; padding: 0; border: 0;
    background: transparent; outline: none; color: var(--ink);
    font: 400 17px/1.5 'Source Sans 3', sans-serif;
  }
  .site-search-input::placeholder { color: var(--muted); opacity: .9; }
  .site-search-input::-webkit-search-cancel-button { cursor: pointer; }
  .site-search-close {
    flex-shrink: 0; border: 1px solid var(--line); border-radius: 7px;
    padding: 6px 9px; background: transparent; color: var(--muted);
    font: 500 10px/1 'IBM Plex Mono', ui-monospace, monospace;
  }
  .site-search-close:hover { border-color: var(--accent); color: var(--ink); }
  .site-search-results { max-height: min(48vh, 375px); overflow-y: auto; padding: 8px; }
  .site-search-option {
    display: flex; flex-direction: column; gap: 3px;
    padding: 11px 14px; border-radius: 9px;
    color: var(--ink); text-decoration: none;
  }
  .site-search-option span { font-size: 14px; font-weight: 700; line-height: 1.35; }
  .site-search-option small { font-size: 12px; color: var(--muted); line-height: 1.45; }
  .site-search-option:hover, .site-search-option.is-active {
    background: var(--accent-soft);
  }
  .site-search-empty { margin: 0; padding: 22px 14px; color: var(--muted); font-size: 14px; }
  .site-search-footer {
    border-top: 1px solid var(--line); padding: 11px 18px;
    font: 500 10px/1.5 'IBM Plex Mono', ui-monospace, monospace;
    color: var(--muted);
  }
  .site-search-footer span { padding: 0 7px; }
  @media (max-width: 1150px) {
    .site-search-launch { min-width: 39px; width: 39px; padding: 0; }
    .site-search-launch kbd { display: none; }
  }
  @media (max-width: 720px) {
    .site-search-launch { width: 36px; min-width: 36px; height: 36px; }
    .site-search-dialog { inset-block-start: 10vh; width: calc(100vw - 24px); }
    .site-search-head { padding: 14px; gap: 10px; }
    .site-search-input { font-size: 15px; }
    .site-search-footer { font-size: 9px; padding-inline: 12px; }
  }
  @media (max-width: 390px) {
    .site-search-launch { min-width: 34px; width: 34px; }
    :global(.header-actions) { gap: 7px; }
    :global(.menu-toggle) { padding-inline: 8px; white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-search-launch { transition: none; }
  }
</style>

<script>
  // The site has six navigable destinations, so an in-memory index is enough.
  // No content fetch is needed, and there are no new scroll animations.
  const trigger = document.querySelector<HTMLButtonElement>('[data-site-search-trigger]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-site-search-dialog]');
  const input = dialog?.querySelector<HTMLInputElement>('.site-search-input');
  const results = dialog?.querySelector<HTMLElement>('.site-search-results');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('.site-search-close');
  const base = trigger?.dataset.base || '/';

  const pages = [
    { title: 'Home', detail: 'Nafiz Fuad Niloy · Energy Science and Engineering, KUET', path: '', tags: 'introduction' },
    { title: 'Undergraduate thesis', detail: 'Reliability-aware graph learning · Lead-free perovskites · CGCNN · ALIGNN', path: 'research/thesis/', tags: 'materials discovery crystal dft research' },
    { title: 'AutoLab SCADA', detail: 'Laboratory automation · Arduino · Python · FastAPI · Live demo', path: 'projects/autolab-scada/', tags: 'temperature monitoring process recipes simulator control' },
    { title: 'Glazing & building energy analysis', detail: 'DesignBuilder · EnergyPlus · Solar heat gain · Cooling electricity', path: 'projects/glazing-energy-analysis/', tags: 'simulation academic project windows' },
    { title: 'Intelligent battery thermal management', detail: 'Arduino · Two temperature sensors · Automated cooling and protection', path: 'projects/battery-thermal-management/', tags: 'third year embedded hardware' },
    { title: 'About / education', detail: 'KUET · Energy Science and Engineering · Nilphamari, Rangpur, Bangladesh', path: '#about', tags: 'location contact background' },
    { title: 'Projects', detail: 'Selected engineering projects', path: '#projects', tags: 'portfolio work' },
    { title: 'Research', detail: 'Undergraduate thesis and current work', path: '#research', tags: 'ongoing thesis' },
  ];
  let active = 0;
  let matches = pages;

  const render = () => {
    if (!results || !input) return;
    const words = input.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
    matches = pages.filter(page => {
      const haystack = `${page.title} ${page.detail} ${page.tags}`.toLocaleLowerCase();
      return words.every(word => haystack.includes(word));
    });
    active = 0;
    results.replaceChildren();
    if (!matches.length) {
      const p = document.createElement('p');
      p.className = 'site-search-empty';
      p.textContent = 'No matching pages.';
      results.append(p);
      return;
    }
    matches.forEach((page, index) => {
      const link = document.createElement('a');
      link.className = 'site-search-option' + (index === 0 ? ' is-active' : '');
      link.href = base + page.path;
      const name = document.createElement('span');
      name.textContent = page.title;
      const description = document.createElement('small');
      description.textContent = page.detail;
      link.append(name, description);
      link.addEventListener('pointermove', () => {
        const links = [...results.querySelectorAll<HTMLAnchorElement>('.site-search-option')];
        if (active !== index) {
          active = index;
          links.forEach((item, i) => item.classList.toggle('is-active', i === active));
        }
      });
      results.append(link);
    });
  };

  const openSearchPalette = () => {
    if (!dialog || !input || dialog.open) return;
    input.value = '';
    render();
    dialog.showModal();
    input.focus();
  };
  const closeSearchPalette = () => dialog?.close();
  trigger?.addEventListener('click', openSearchPalette);
  closeButton?.addEventListener('click', closeSearchPalette);
  input?.addEventListener('input', render);
  dialog?.addEventListener('close', () => trigger?.focus({preventScroll: true}));
  dialog?.addEventListener('pointerdown', event => {
    // Dialog's backdrop sends a pointer event whose target is the dialog.
    if (event.target !== dialog) return;
    const rect = dialog.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) closeSearchPalette();
  });
  document.addEventListener('keydown', event => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog?.open ? closeSearchPalette() : openSearchPalette();
      return;
    }
    if (dialog?.open && event.key === 'Escape') {
      event.preventDefault();
      closeSearchPalette();
      return;
    }
    if (!dialog?.open || !results) return;
    const links = [...results.querySelectorAll<HTMLAnchorElement>('.site-search-option')];
    if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && links.length) {
      event.preventDefault();
      active = (active + (event.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
      links.forEach((item, i) => item.classList.toggle('is-active', i === active));
      links[active].scrollIntoView({block: 'nearest'});
    }
    if (event.key === 'Enter' && links.length && document.activeElement === input) {
      event.preventDefault();
      window.location.assign(links[active].href);
    }
  });
</script>
