---
import BaseLayout from '../layouts/BaseLayout.astro';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Nafiz Fuad Niloy | Research & Engineering" description="Nafiz Fuad Niloy — research in crystal graph learning for energy materials, with selected engineering projects.">
<main id="main">
    <section class="hero container" aria-labelledby="name">
      <div class="hero-text">
        <p class="eyebrow"><span class="eyebrow-line"></span> Energy Science & Engineering / KUET</p>
        <h1 id="name">Nafiz Fuad<br><span>Niloy.</span></h1>
        <p class="hero-lead">I'm a final-year undergraduate at KUET, interested in machine learning and computational methods for energy materials.</p>
        <p class="hero-support">My current thesis focuses on lead-free perovskite absorbers. I've also worked on building energy simulation, thermal monitoring and laboratory automation.</p>
        <div class="hero-links">
          <a class="button button-primary" href="#research">Current research <span aria-hidden="true">↗</span></a>
          <a class="understated-link" href="#projects">Selected projects <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="Research summary">
        <div class="aside-top"><span>RESEARCH FOCUS</span><span class="aside-index">2026–27</span></div>
        <div class="focus-copy">
          <span class="focus-symbol" aria-hidden="true">
            <svg viewBox="0 0 88 88" fill="none"><path d="m44 7 31 18v38L44 81 13 63V25L44 7Z" stroke="currentColor" stroke-width="1.5"/><path d="M44 7v37m31-19L44 44 13 25m0 38 31-19 31 19M44 44v37" stroke="currentColor" stroke-width="1.25"/><circle cx="44" cy="44" r="5" fill="currentColor"/><circle cx="44" cy="7" r="3" fill="currentColor"/><circle cx="13" cy="25" r="3" fill="currentColor"/><circle cx="75" cy="63" r="3" fill="currentColor"/></svg>
          </span>
          <h2>Graph learning for<br>energy materials</h2>
          <p>Crystal structure · Property prediction · Model reliability</p>
        </div>
        <div class="aside-bottom"><span>Undergraduate thesis</span><span><span class="status-dot"></span> Ongoing · 2026–27</span></div>
      </aside>
      <div class="hero-footnote"><span>BASED IN KHULNA, BANGLADESH</span><span>DEPARTMENT OF ENERGY SCIENCE AND ENGINEERING</span></div>
    </section>

    <section class="section section-research" id="research" aria-labelledby="research-title">
      <div class="container">
        <div class="section-head"><span class="section-no">01 / RESEARCH</span><h2 id="research-title">Current <em>research</em></h2></div>
        <article class="research-panel">
          <div class="research-content">
            <div class="research-topline"><span>UNDERGRADUATE THESIS</span><span class="status-text"><span class="status-dot"></span> ONGOING</span></div>
            <h3>Reliability-aware graph learning for lead-free perovskites</h3>
            <p>Studying crystal graph neural networks and uncertainty-aware property prediction for lead-free halide perovskite photovoltaic absorbers.</p>
            <p class="research-note">This is ongoing work; research results have not yet been reported here.</p>
            <div class="research-methods"><span>CGCNN</span><span>ALIGNN</span><span>DFT</span><span>Uncertainty quantification</span></div>
            <div class="supervision"><span>SUPERVISOR</span><p>Md. Mahmodul Alam<br><small>Assistant Professor, Dept. of Energy Science and Engineering, KUET</small></p></div><a class="understated-link thesis-detail-link" href={`${base}research/thesis/`}>Read thesis details <span aria-hidden="true">↗</span></a>
          </div>
          <figure class="research-figure">
            <div class="research-image-wrap">
              <img class="image-light" src={`${base}images/perovskite-light.png`} alt="Conceptual crystal graph illustration for the perovskite research" loading="lazy" decoding="async">
              <img class="image-dark" src={`${base}images/perovskite-dark.png`} alt="" aria-hidden="true" loading="lazy" decoding="async">
            </div>
            <figcaption>Conceptual crystal-graph illustration; not a computed structure.</figcaption>
          </figure>
        </article>
      </div>
    </section>

    <section class="section section-projects" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-head"><span class="section-no">02 / ENGINEERING WORK</span><h2 id="projects-title">Selected <em>projects</em></h2><p class="section-intro">Coursework and independent engineering work, with source files and reports where available.</p></div>
        <div class="project-grid">
          <article class="project-card">
            <div class="project-visual">
              <img class="image-light" src={`${base}images/autolab-scada-welcome-light.png`} alt="AutoLab SCADA public demo interface with simulated process data" loading="lazy" decoding="async">
              <img class="image-dark" src={`${base}images/autolab-scada-welcome-dark.png`} alt="" aria-hidden="true" loading="lazy" decoding="async">
            </div>
            <div class="project-body">
              <div class="project-meta"><span>2026 / SOFTWARE & AUTOMATION</span><span>COMPLETED</span></div>
              <h3>AutoLab SCADA</h3>
              <p>An Arduino-connected monitoring and control workspace with temperature readings, programmable process sequences and run history. The public demo operates with simulated data.</p>
              <p class="project-tools">Python · FastAPI · Arduino · JavaScript</p>
              <div class="resource-links"><a class="detail-resource-link" href={`${base}projects/autolab-scada/`}>Read details <span aria-hidden="true">↗</span></a><a href="https://nf-niloy.github.io/autolab-scada/" target="_blank" rel="noopener noreferrer">Live demo <span aria-hidden="true">↗</span></a><a href="https://github.com/nf-niloy/autolab-scada" target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a></div>
            </div>
          </article>
          <article class="project-card">
            <div class="project-visual"><img src="https://raw.githubusercontent.com/nf-niloy/glazing-energy-analysis/main/figures/building-model.png" alt="DesignBuilder model of the residential building used in the glazing study" loading="lazy" decoding="async"></div>
            <div class="project-body">
              <div class="project-meta"><span>2026 / ACADEMIC PROJECT</span><span>COMPLETED</span></div>
              <h3>Glazing & building energy analysis</h3>
              <p>Compared four glazing types in DesignBuilder and EnergyPlus. Double Low-E glazing gave a 3.16% reduction in simulated annual cooling electricity for the modeled building.</p>
              <p class="project-tools">DesignBuilder · EnergyPlus · Energy simulation</p>
              <div class="resource-links"><a class="detail-resource-link" href={`${base}projects/glazing-energy-analysis/`}>Read details <span aria-hidden="true">↗</span></a><a href="https://github.com/nf-niloy/glazing-energy-analysis" target="_blank" rel="noopener noreferrer">Project files <span aria-hidden="true">↗</span></a><a href="https://github.com/nf-niloy/glazing-energy-analysis/blob/main/report/glazing-systems-energy-performance.pdf" target="_blank" rel="noopener noreferrer">Report <span aria-hidden="true">↗</span></a></div>
            </div>
          </article>
          <article class="project-card">
            <div class="project-visual"><img src="https://raw.githubusercontent.com/nf-niloy/arduino-battery-thermal-management/main/assets/setup.jpg" alt="Arduino, sensors, relays, fan and wiring in a battery thermal management prototype" loading="lazy" decoding="async"></div>
            <div class="project-body">
              <div class="project-meta"><span>2025 / THIRD-YEAR PROJECT</span><span>COMPLETED</span></div>
              <h3>Intelligent battery thermal management</h3>
              <p>An Arduino-based system using two temperature sensors, automated cooling and staged thermal protection, with status displayed on an LCD.</p>
              <p class="project-tools">Arduino · Temperature sensing · Embedded control</p>
              <div class="resource-links"><a class="detail-resource-link" href={`${base}projects/battery-thermal-management/`}>Read details <span aria-hidden="true">↗</span></a><a href="https://github.com/nf-niloy/arduino-battery-thermal-management" target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a><a href="https://github.com/nf-niloy/arduino-battery-thermal-management/blob/main/report/Battery_Thermal_Management_Project_Report.pdf" target="_blank" rel="noopener noreferrer">Report <span aria-hidden="true">↗</span></a></div>
            </div>
          </article>
        </div>
        <p class="more-work">Additional repositories and technical work are available on <a href="https://github.com/nf-niloy?tab=repositories" target="_blank" rel="noopener noreferrer">GitHub ↗</a>.</p>
      </div>
    </section>

    <section class="section section-about" id="about" aria-labelledby="about-title">
      <div class="container">
        <div class="section-head"><span class="section-no">03 / BACKGROUND</span><h2 id="about-title">About <em>me</em></h2></div>
        <div class="about-grid">
          <div class="about-prose">
            <p>I'm completing my B.Sc. in Energy Science and Engineering at Khulna University of Engineering & Technology (KUET), Bangladesh.</p>
            <p>My interests include machine learning for materials, atomistic modeling and computational approaches to engineering problems. My projects have also involved laboratory control and building energy simulation.</p>
            <a class="understated-link contact-link" href="https://linktr.ee/niloynf9" target="_blank" rel="noopener noreferrer">Contact / links <span aria-hidden="true">↗</span></a>
          </div>
          <div class="about-details">
            <div class="detail-line"><span>EDUCATION</span><p>B.Sc. in Energy Science and Engineering<br><small>Khulna University of Engineering & Technology</small></p></div>
            <div class="detail-line"><span>RESEARCH INTERESTS</span><p>Crystal graph learning<br>Energy materials<br>Computational materials science</p></div>
            <div class="detail-line"><span>LOCATION</span><p>Khulna, Bangladesh</p></div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
